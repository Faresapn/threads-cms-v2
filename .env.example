# Threads CMS v2 — R2 credential (shared bucket 'media' dgn PromptedSite)
# Copy ke .env dan isi. JANGAN commit secret asli.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_MEDIA_BUCKET=media
R2_CDN_URL=https://cdn.promptedsite.com
R2_PREFIX=threads

# AI generate (9Router lokal, OpenAI-compatible)
AI_BASE_URL=http://localhost:20128/v1
AI_API_KEY=
AI_MODEL=cc/claude-sonnet-5
